# --- ComfyUI ---
COMFY_HOST=http://127.0.0.1:8188
COMFY_OUTPUT_DIR=./output

# --- RabbitMQ broker ---
# When unset / unreachable, the worker falls back to HTTP polling.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
BROKER_PREFETCH=1

# --- HTTP polling fallback ---
# Backend that hands out jobs when RabbitMQ is down. Must expose:
#   GET  {BACKEND_URL}/jobs/next?lane=<lane>
#   POST {BACKEND_URL}/jobs/{id}/ack
BACKEND_URL=http://localhost:4001/api
POLL_INTERVAL_SECONDS=5

# --- Callbacks ---
# All progress / completion / failure callbacks go here.
CALLBACK_URL=http://localhost:4001/api/jobs/callback
CALLBACK_SECRET=change-me

# --- Worker ---
WORKER_NAME=worker-1
LANES=video,image,lipsync,audio,mesh
HEARTBEAT_SECONDS=30

# --- VRAM strategy ---
# Comma-separated model identifiers that should auto-flip to lowvram.
HEAVY_VRAM_MODELS=hunyuan,wan,flux-dev,ltx
SAGE_ATTENTION=1
